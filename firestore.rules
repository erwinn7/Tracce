rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Unique collection des quêtes (12 quêtes initiales + ajouts admin)
    // Lecture publique pour tous les joueurs, écriture pour les ajouts
    match /quests/{questId} {
      allow read, write: if true;
    }

    // Profils et identifiants des utilisateurs (UID)
    // Permet de stocker l'ID de l'utilisateur, son pseudo, ses points et sa progression
    match /users/{uid} {
      allow read, write: if true;
    }

    // Complétions de quêtes de chaque utilisateur
    // Structure : users/{uid}/completions/{questId}
    match /users/{uid}/completions/{questId} {
      allow read, write: if true;
    }
  }
}
