{
  "name": "tracce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-seo.ts",
    "build:seo": "tsx scripts/build-seo.ts",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "^0.33.0",
    "tsx": "^4.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "@firebase/util@1.12.1": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
